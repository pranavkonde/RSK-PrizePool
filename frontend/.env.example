# Set after running deploy script from project root
VITE_VAULT_ADDRESS=0xYourVaultAddressHere
VITE_ASSET_ADDRESS=0xYourAssetAddressHere

# For testnet: use "rootstock_testnet" (chainId 31)
# For mainnet: use "rootstock" (chainId 30)
# Omit for localhost
VITE_CHAIN=rootstock_testnet

# Optional: Rootstock testnet HTTP RPC when public endpoints rate-limit (ResourceUnavailableRpcError).
# Example providers expose chain 31 endpoints in their dashboards.
# VITE_RSK_TESTNET_RPC_URL=https://your-provider.example/rsk-testnet
